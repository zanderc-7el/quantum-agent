# Copy to local.env; never commit API keys. Existing environment takes precedence.
QCAL_MODEL_PROTOCOL=codex_cli
# For HTTP: anthropic_messages | openai_chat_completions | openai_responses
# QCAL_MODEL_BASE_URL=https://your-provider.example/v1
# QCAL_MODEL_API_KEY=
# QCAL_MODEL=your-model
# Local HTTP servers can explicitly opt into no-key mode.
# QCAL_MODEL_ALLOW_NO_KEY=false
QCAL_AGENT_PORT=8766
QCAL_MODEL_TIMEOUT_MS=90000
# If the existing Windows system proxy is required, scope it to this CLI child:
# QCAL_CODEX_PROXY=http://127.0.0.1:your-proxy-port
